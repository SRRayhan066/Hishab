generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  image             String?
  locale            String             @default("bn")
  currency          String             @default("BDT")
  tourCompletedAt   DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  accounts          Account[]
  moneyAccounts     MoneyAccount[]
  passwordResetOtps PasswordResetOtp[]
  budgetMonths      BudgetMonth[]
  debtPeople        DebtPerson[]
}

model MoneyAccount {
  id             String   @id @default(cuid())
  userId         String
  name           String
  openingBalance Int      @default(0)
  color          String   @default("sage")
  icon           String   @default("wallet")
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes      IncomeSource[]
  expenses     Expense[]
  transfersOut Transfer[]     @relation("TransferFrom")
  transfersIn  Transfer[]     @relation("TransferTo")
  adjustments  BalanceAdjustment[]
  debtEntries  DebtEntry[]

  @@index([userId])
}

model PasswordResetOtp {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// One row per user per calendar month. A fresh month is created by copying the
/// newest earlier month, so the plan carries forward until the user edits it.
model BudgetMonth {
  id           String   @id @default(cuid())
  userId       String
  year         Int
  month        Int
  seededFromId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  seededFrom BudgetMonth?    @relation("MonthSeed", fields: [seededFromId], references: [id], onDelete: SetNull)
  seeded     BudgetMonth[]   @relation("MonthSeed")
  incomes    IncomeSource[]
  categories SpendCategory[]
  transfers  Transfer[]
  adjustments BalanceAdjustment[]
  debtEntries DebtEntry[]

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model IncomeSource {
  id        String   @id @default(cuid())
  monthId   String
  /// Stays the same when the row is copied forward, so one source can be
  /// followed across months even after a rename.
  lineageId String   @default(cuid())
  name      String
  amount    Int      @default(0)
  accountId String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  month   BudgetMonth  @relation(fields: [monthId], references: [id], onDelete: Cascade)
  account MoneyAccount @relation(fields: [accountId], references: [id], onDelete: NoAction)

  @@index([monthId])
  @@index([lineageId])
  @@index([accountId])
}

model SpendCategory {
  id        String   @id @default(cuid())
  monthId   String
  lineageId String   @default(cuid())
  name      String
  budget    Int      @default(0)
  /// Added on the fly from the add-expense screen. Belongs to this month only:
  /// it has no budget, stays off the plan and is not copied into the next month.
  temporary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  month    BudgetMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([monthId])
  @@index([lineageId])
}

model Expense {
  id         String   @id @default(cuid())
  categoryId String
  accountId  String
  day        Int
  amount     Int
  note       String?
  createdAt  DateTime @default(now())

  category SpendCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  account  MoneyAccount  @relation(fields: [accountId], references: [id], onDelete: NoAction)

  @@index([categoryId])
  @@index([accountId])
}

model Transfer {
  id        String   @id @default(cuid())
  monthId   String
  fromId    String
  toId      String
  day       Int
  amount    Int
  createdAt DateTime @default(now())

  month BudgetMonth  @relation(fields: [monthId], references: [id], onDelete: Cascade)
  from  MoneyAccount @relation("TransferFrom", fields: [fromId], references: [id], onDelete: NoAction)
  to    MoneyAccount @relation("TransferTo", fields: [toId], references: [id], onDelete: NoAction)

  @@index([monthId])
  @@index([fromId])
  @@index([toId])
}

model BalanceAdjustment {
  id        String   @id @default(cuid())
  monthId   String
  accountId String
  day       Int
  amount    Int
  createdAt DateTime @default(now())

  month   BudgetMonth  @relation(fields: [monthId], references: [id], onDelete: Cascade)
  account MoneyAccount @relation(fields: [accountId], references: [id], onDelete: NoAction)

  @@index([monthId])
  @@index([accountId])
}

enum DebtKind {
  lend
  borrow
  gotBack
  paidBack
}

model DebtPerson {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries DebtEntry[]

  @@unique([userId, name])
  @@index([userId])
}

model DebtEntry {
  id        String   @id @default(cuid())
  personId  String
  monthId   String
  accountId String
  kind      DebtKind
  day       Int
  amount    Int
  note      String?
  createdAt DateTime @default(now())

  person  DebtPerson   @relation(fields: [personId], references: [id], onDelete: Cascade)
  month   BudgetMonth  @relation(fields: [monthId], references: [id], onDelete: Cascade)
  account MoneyAccount @relation(fields: [accountId], references: [id], onDelete: NoAction)

  @@index([personId])
  @@index([monthId])
  @@index([accountId])
}
