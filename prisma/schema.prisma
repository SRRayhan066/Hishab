generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  image             String?
  /// What was in the wallet/bank the day the app was first used. Every
  /// month's income is added on top and every expense taken off.
  openingBalance    Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  accounts          Account[]
  passwordResetOtps PasswordResetOtp[]
  budgetMonths      BudgetMonth[]
}

model PasswordResetOtp {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// One row per user per calendar month. A fresh month is created by copying the
/// newest earlier month, so the plan carries forward until the user edits it.
model BudgetMonth {
  id           String   @id @default(cuid())
  userId       String
  year         Int
  month        Int
  seededFromId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  seededFrom BudgetMonth?    @relation("MonthSeed", fields: [seededFromId], references: [id], onDelete: SetNull)
  seeded     BudgetMonth[]   @relation("MonthSeed")
  incomes    IncomeSource[]
  categories SpendCategory[]

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model IncomeSource {
  id        String   @id @default(cuid())
  monthId   String
  /// Stays the same when the row is copied forward, so one source can be
  /// followed across months even after a rename.
  lineageId String   @default(cuid())
  name      String
  amount    Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  month BudgetMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@index([monthId])
  @@index([lineageId])
}

model SpendCategory {
  id        String   @id @default(cuid())
  monthId   String
  lineageId String   @default(cuid())
  name      String
  budget    Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  month    BudgetMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([monthId])
  @@index([lineageId])
}

model Expense {
  id         String   @id @default(cuid())
  categoryId String
  day        Int
  amount     Int
  note       String?
  createdAt  DateTime @default(now())

  category SpendCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}
