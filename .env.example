# End both with `?sslmode=verify-full&channel_binding=require`.
# Neon hands you `sslmode=require`, which node-postgres treats as verify-full
# today but will downgrade to "encrypt, don't verify" in pg v9. Spelling out
# verify-full keeps today's behaviour and silences the startup warning.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
